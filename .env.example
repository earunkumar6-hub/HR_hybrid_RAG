# Copy this file to .env (project root) and fill in your keys.
# Both backend/config.py (via pydantic-settings) and the eval/guardrail
# modules read these from the environment.

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.1

# ---- Chroma ----
CHROMA_COLLECTION=internal_knowledge

# ---- Retrieval tuning ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_VECTOR=5
TOP_K_GRAPH=8
GRAPH_TRAVERSAL_DEPTH=2

# ---- Guardrails ----
# true  -> try NeMo Guardrails, auto-falls back to the lightweight rule
#          engine if nemoguardrails isn't installed / fails to init
# false -> disable guardrail checks entirely
GUARDRAILS_ENABLED=true

# ---- LangSmith tracing (optional, https://smith.langchain.com) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=internal-knowledge-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- Servers ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000
